{"code":200,"status":"OK","data":[{"number":275,"text":"ٱلشَّيْطَٰنُ يَعِدُكُمُ ٱلْفَقْرَ وَيَأْمُرُكُم بِٱلْفَحْشَآءِ ۖ وَٱللَّهُ يَعِدُكُم مَّغْفِرَةًۭ مِّنْهُ وَفَضْلًۭا ۗ وَٱللَّهُ وَٰسِعٌ عَلِيمٌۭ","edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"},"surah":{"number":2,"name":"سُورَةُ البَقَرَةِ","englishName":"Al-Baqara","englishNameTranslation":"The Cow","numberOfAyahs":286,"revelationType":"Medinan"},"numberInSurah":268,"juz":3,"manzil":1,"page":45,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":275,"text":"Дьявол угрожает вам бедностью и велит творить мерзость. Аллах же обещает вам прощение от Него и милость. Аллах - Объемлющий, Знающий.","edition":{"identifier":"ru.kuliev","language":"ru","name":"Кулиев","englishName":"Elmir Kuliev","format":"text","type":"translation","direction":"ltr"},"surah":{"number":2,"name":"سُورَةُ البَقَرَةِ","englishName":"Al-Baqara","englishNameTranslation":"The Cow","numberOfAyahs":286,"revelationType":"Medinan"},"numberInSurah":268,"juz":3,"manzil":1,"page":45,"ruku":38,"hizbQuarter":18,"sajda":false}]}